<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\JackONNX\JackONNX.csproj" />
    <ProjectReference Include="..\heirowLLM.Security\heirowLLM.Security.csproj" />
    <ProjectReference Include="..\heirowLLM.SecurityBroker\heirowLLM.SecurityBroker.csproj" ReferenceOutputAssembly="false" Condition="'$(Configuration)' == 'Debug'" />
    <ProjectReference Include="..\LlmRuntime\LlmRuntime.csproj" />
    <ProjectReference Include="..\LlmRuntime.Wpf\LlmRuntime.Wpf.csproj" />
    <ProjectReference Include="..\SocketJack\SocketJack.csproj" />
    <ProjectReference Include="..\SocketJack.LlmCore\SocketJack.LlmCore.csproj" />
    <ProjectReference Include="..\SocketJack.Stripe\SocketJack.Stripe.csproj" />
    <ProjectReference Include="..\heirowLLMUpdater\heirowLLMUpdater.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" Condition="'$(IncludeheirowLLMUpdater)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
    <PackageReference Include="System.Text.Json" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\tools\linux\install-heirowllm-cuda-pytorch.sh" Link="install\linux\install-heirowllm-cuda-pytorch.sh" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="Docs\Getting-Started.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
    <ApplicationDefinition Remove="bin\**\*.xaml" />
    <ApplicationDefinition Remove="obj\**\*.xaml" />
    <EmbeddedResource Remove="artifacts\**" />
    <EmbeddedResource Remove="bin\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="artifacts\**" />
    <None Remove="bin\**" />
    <None Remove="obj\**" />
    <Page Remove="artifacts\**" />
    <Page Remove="bin\**\*.xaml" />
    <Page Remove="obj\**\*.xaml" />
    <Compile Include="..\SocketJack.Windows\Controller\ClickIndicatorAdorner.cs" Link="SocketJack.WPF\Controller\ClickIndicatorAdorner.cs" />
    <Compile Include="..\SocketJack.Windows\Controller\ControlBitmapCapture.cs" Link="SocketJack.WPF\Controller\ControlBitmapCapture.cs" />
    <Compile Include="..\SocketJack.Windows\Controller\ControlShareFrame.cs" Link="SocketJack.WPF\Controller\ControlShareFrame.cs" />
    <Compile Include="..\SocketJack.Windows\Controller\ControlShareViewer.cs" Link="SocketJack.WPF\Controller\ControlShareViewer.cs" />
    <Compile Include="..\SocketJack.Windows\Controller\ElementRoute.cs" Link="SocketJack.WPF\Controller\ElementRoute.cs" />
    <Compile Include="..\SocketJack.Windows\Controller\Extensions.cs" Link="SocketJack.WPF\Controller\Extensions.cs" />
    <Compile Include="..\SocketJack.Windows\Controller\FrameworkElementShareExtensions.cs" Link="SocketJack.WPF\Controller\FrameworkElementShareExtensions.cs" />
    <Compile Include="..\SocketJack.Windows\Controller\HeirowLlmWpfRemoteControl.cs" Link="SocketJack.WPF\Controller\HeirowLlmWpfRemoteControl.cs" />
    <Compile Include="..\SocketJack.Windows\Controller\RemoteAction.cs" Link="SocketJack.WPF\Controller\RemoteAction.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="..\SocketJack.Windows\Controller\*.cs">
      <Nullable>disable</Nullable>
    </Compile>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <AssemblyTitle>heirowLLM Workstation</AssemblyTitle>
    <Product>heirowLLM Workstation</Product>
    <ApplicationIcon>Assets\heirowLLM.ico</ApplicationIcon>
    <Version>26.8.4</Version>
    <AssemblyVersion>26.8.4.0</AssemblyVersion>
    <FileVersion>26.8.4.0</FileVersion>
    <InformationalVersion>2026.8.4</InformationalVersion>
    <StartupObject>heirowLLM.App</StartupObject>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8618;CS8622;CS8625</NoWarn>
    <JackOnnxBundleCudaDependencies>true</JackOnnxBundleCudaDependencies>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);HEIROWLLM_SECURE_RELEASE</DefineConstants>
    <OutputPath>bin\Release\net8.0-windows10.0.17763.0\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\heirowLLM.ico" />
    <Resource Include="Assets\heirowLLM.png" />
    <Resource Include="..\SocketJack\html\picturebank-chicken-chaser-sprites.png" Link="Assets\picturebank-chicken-chaser-sprites.png" />
  </ItemGroup>

  <Target Name="CopyheirowLLMUpdater" AfterTargets="Build" Condition="'$(IncludeheirowLLMUpdater)' == 'true'">
    <ItemGroup>
      <heirowLLMUpdaterFiles Include="..\heirowLLMUpdater\bin\$(Configuration)\net8.0-windows7.0\heirowLLMUpdater.*" />
    </ItemGroup>
    <Copy SourceFiles="@(heirowLLMUpdaterFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(heirowLLMUpdaterFiles)' != ''" />
  </Target>

  <Target Name="BundleOfficialSecurityBroker" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true' and '$(BundleOfficialSecurityBroker)' != 'false'">
    <GetFileHash Files="$(OutDir)$(AssemblyName).exe" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_SecureReleaseWorkstationHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(OutDir)secure-release.sha256" Lines="@(_SecureReleaseWorkstationHash->'%(FileHash)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <MSBuild Projects="..\heirowLLM.SecurityBroker\heirowLLM.SecurityBroker.csproj" Targets="Build" BuildInParallel="false" Properties="Configuration=Release;RuntimeIdentifier=win-x64" />
    <ItemGroup>
      <OfficialSecurityBrokerFiles Include="..\heirowLLM.SecurityBroker\bin\Release\net8.0-windows10.0.17763.0\win-x64\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(OfficialSecurityBrokerFiles)" DestinationFiles="@(OfficialSecurityBrokerFiles->'$(OutDir)SecurityBroker\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(OutDir)SecurityBroker\heirowLLM.SecurityBroker.exe')" Text="The official Release security broker was not produced beside heirowLLM.exe." />
    <Error Condition="!Exists('$(OutDir)secure-release.sha256')" Text="The secure Release workstation hash was not produced beside heirowLLM.exe." />
  </Target>

</Project>
