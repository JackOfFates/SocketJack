<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="LlmRuntime.Wpf.HuggingFaceModelDownloaderControl"
             d:DesignHeight="768.76" d:DesignWidth="1679.816">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BrowserBackgroundBrush" Color="#101216" />
        <SolidColorBrush x:Key="BrowserPanelBrush" Color="#161B22" />
        <SolidColorBrush x:Key="BrowserPanelAltBrush" Color="#111821" />
        <SolidColorBrush x:Key="BrowserBorderBrush" Color="#2D3440" />
        <SolidColorBrush x:Key="BrowserTextBrush" Color="#F2F4F8" />
        <SolidColorBrush x:Key="BrowserSubtleTextBrush" Color="#AAB4C3" />
        <SolidColorBrush x:Key="BrowserAccentBrush" Color="#FF5C7A" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrowserTextBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#1D2630" />
            <Setter Property="Foreground" Value="{StaticResource BrowserTextBrush}" />
            <Setter Property="BorderBrush" Value="#3B4654" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#283544" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#526276" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#151D26" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#121820" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#28313C" />
                                <Setter Property="Foreground" Value="#657182" />
                                <Setter Property="Opacity" Value="0.72" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrowserNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavChrome" Property="Opacity" Value="0.68" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.36" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#25313F" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BrowserBackButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BrowserNavButtonStyle}">
            <Setter Property="Foreground" Value="#60A5FA" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#A7D2FF" />
                    <Setter Property="Background" Value="#18304A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BrowserForwardButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BrowserNavButtonStyle}">
            <Setter Property="Foreground" Value="#35D0BA" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#8AF2E3" />
                    <Setter Property="Background" Value="#153A36" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BrowserHomeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BrowserNavButtonStyle}">
            <Setter Property="Foreground" Value="#B695F8" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#D6C4FF" />
                    <Setter Property="Background" Value="#2D2346" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BrowserAddressBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="#111720" />
            <Setter Property="Foreground" Value="{StaticResource BrowserTextBrush}" />
            <Setter Property="CaretBrush" Value="#60A5FA" />
            <Setter Property="BorderBrush" Value="#344151" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="#5060A5FA" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="AddressChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AddressChrome" Property="Background" Value="#151D28" />
                                <Setter TargetName="AddressChrome" Property="BorderBrush" Value="#496078" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="AddressChrome" Property="Background" Value="#0E151E" />
                                <Setter TargetName="AddressChrome" Property="BorderBrush" Value="#60A5FA" />
                                <Setter TargetName="AddressChrome" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E141B" />
            <Setter Property="Foreground" Value="{StaticResource BrowserTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrowserBorderBrush}" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrowserTextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="{StaticResource BrowserAccentBrush}" />
            <Setter Property="Background" Value="#0E141B" />
            <Setter Property="BorderBrush" Value="{StaticResource BrowserBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <DataTemplate x:Key="DownloadQueueItemTemplate">
            <Border Margin="0,0,0,8"
                    Padding="10"
                    Background="{Binding StatusBackground}"
                    BorderBrush="{Binding StatusBorder}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="{Binding FileName}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FileName}" />
                        <TextBlock Text="{Binding Detail}"
                                   Foreground="{StaticResource BrowserSubtleTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Content="Cancel"
                            Click="CancelDownloadItemButton_Click"
                            CommandParameter="{Binding Id}"
                            MinHeight="24"
                            Padding="8,2"
                            Visibility="{Binding CancelVisibility}"
                            AutomationProperties.Name="Cancel this model download" />

                    <ProgressBar Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 Value="{Binding Percent}"
                                 Visibility="{Binding ProgressVisibility}"
                                 Margin="0,9,0,0" />

                    <DockPanel Grid.Row="2"
                               Grid.ColumnSpan="2"
                               LastChildFill="True"
                               Margin="0,7,0,0">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding PercentText}"
                                   Foreground="{Binding StatusForeground}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Status}"
                                   Foreground="{Binding StatusForeground}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource BrowserBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="8,5"
                Padding="5,1"
                Background="#C51A202A"
                BorderBrush="#303B49"
                BorderThickness="1"
                CornerRadius="9">
            <DockPanel LastChildFill="True">
                <Button x:Name="BackButton"
                        Click="BackButton_Click"
                        Style="{StaticResource BrowserBackButtonStyle}"
                        ToolTip="Back"
                        AutomationProperties.Name="Back"
                        AutomationProperties.HelpText="Navigate back in the Hugging Face browser.">
                    <Viewbox Width="15" Height="15">
                        <Path Data="M 15,2 L 5,10 L 15,18"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Viewbox>
                </Button>
                <Button x:Name="ForwardButton"
                        Click="ForwardButton_Click"
                        Style="{StaticResource BrowserForwardButtonStyle}"
                        ToolTip="Forward"
                        AutomationProperties.Name="Forward"
                        AutomationProperties.HelpText="Navigate forward in the Hugging Face browser.">
                    <Viewbox Width="15" Height="15">
                        <Path Data="M 5,2 L 15,10 L 5,18"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Viewbox>
                </Button>
                <Button x:Name="RefreshButton"
                        Click="RefreshButton_Click"
                        Content="Refresh"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Refresh"
                        AutomationProperties.HelpText="Reload the current Hugging Face page." />
                <Button x:Name="HomeButton"
                        DockPanel.Dock="Right"
                        Click="HomeButton_Click"
                        Style="{StaticResource BrowserHomeButtonStyle}"
                        ToolTip="Hugging Face model search"
                        AutomationProperties.Name="Home"
                        AutomationProperties.HelpText="Open GGUF model search on Hugging Face.">
                    <Viewbox Width="16" Height="16">
                        <Path Data="M 3,9.5 L 10,3 L 17,9.5 M 5.5,8.5 L 5.5,17 L 14.5,17 L 14.5,8.5 M 8.5,17 L 8.5,12 L 11.5,12 L 11.5,17"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Viewbox>
                </Button>
                <TextBox x:Name="AddressBox"
                         Style="{StaticResource BrowserAddressBoxStyle}"
                         AutomationProperties.Name="Hugging Face address"
                         AutomationProperties.HelpText="Type a Hugging Face URL and press Enter."
                         KeyDown="AddressBox_KeyDown" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border x:Name="BrowserHost"
                    Background="{StaticResource BrowserPanelBrush}"
                    BorderBrush="{StaticResource BrowserBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <wv2:WebView2 x:Name="Browser" AutomationProperties.Name="Hugging Face model browser" />
            </Border>

            <Border x:Name="ExternalBrowserFallbackPanel"
                    Visibility="Collapsed"
                    Background="{StaticResource BrowserPanelBrush}"
                    BorderBrush="{StaticResource BrowserBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="1" MaxWidth="560" HorizontalAlignment="Center">
                        <TextBlock Text="Linux Browser Mode"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="The embedded browser is unavailable in this Linux/Wine session. Open Hugging Face in the Linux browser, paste a model URL above, then queue the best downloadable file from that repository."
                                   Foreground="{StaticResource BrowserSubtleTextBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,18" />
                        <UniformGrid Columns="2">
                            <Button x:Name="OpenExternalBrowserButton"
                                    Margin="0,0,6,0"
                                    Click="OpenExternalBrowserButton_Click"
                                    Content="Open Hugging Face"
                                    AutomationProperties.Name="Open Hugging Face in Linux browser" />
                            <Button x:Name="QueueBestFromAddressButton"
                                    Margin="6,0,0,0"
                                    Click="QueueBestFromAddressButton_Click"
                                    Content="Queue Best Download"
                                    AutomationProperties.Name="Scan the pasted Hugging Face model URL and queue the best download" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="10,0,0,0"
                    Padding="12"
                    Background="{StaticResource BrowserPanelBrush}"
                    BorderBrush="{StaticResource BrowserBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
                        <TextBlock x:Name="QueueSummaryText"
                                   DockPanel.Dock="Right"
                                   Text="Idle"
                                   Foreground="{StaticResource BrowserSubtleTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="Downloads" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Queued model files and bundles"
                                       Foreground="{StaticResource BrowserSubtleTextBrush}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <CheckBox x:Name="LoadAfterDownloadCheckBox"
                              Grid.Row="1"
                              Content="Load after download"
                              AutomationProperties.Name="Load after download"
                              ToolTip="Automatically load the downloaded GGUF model into LlmRuntime when the download finishes."
                              IsChecked="False"
                              Margin="0,0,0,10" />

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <ProgressBar x:Name="DownloadProgressBar"
                                     AutomationProperties.Name="Download progress" />
                        <TextBlock x:Name="HealthText"
                                   Foreground="{StaticResource BrowserSubtleTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="Local model health appears here after a download."
                                   AutomationProperties.Name="Local model health" />
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                    <Border Margin="0,0,0,8"
                            Padding="10"
                            Background="#151D28"
                            BorderBrush="#3D5067"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="heirowSong local music model" FontWeight="SemiBold" />
                            <TextBlock Text="ACE-Step 1.5 pinned bundle · 11.64 GiB · MIT · local/private"
                                       Foreground="{StaticResource BrowserSubtleTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,8" />
                            <Button x:Name="InstallHeirowSongButton"
                                    Click="InstallHeirowSongButton_Click"
                                    Content="Install heirowSong"
                                    AutomationProperties.Name="Install heirowSong model bundle"
                                    AutomationProperties.HelpText="Validate and queue the pinned ACE-Step 1.5 repositories required by heirowSong." />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,0,10"
                            Padding="10"
                            Background="#151D28"
                            BorderBrush="#3D5067"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="PictureBank local AI tools" FontWeight="SemiBold" />
                            <TextBlock Text="Pinned SD 1.5 generation/inpainting, SAM selection, and BiRefNet-lite background removal · local/private"
                                       Foreground="{StaticResource BrowserSubtleTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,8" />
                            <Button x:Name="InstallPictureBankAiButton"
                                    Click="InstallPictureBankAiButton_Click"
                                    Content="Install PictureBank AI"
                                    AutomationProperties.Name="Install PictureBank AI model bundle"
                                    AutomationProperties.HelpText="Validate pinned Hugging Face revisions and queue the reviewed safetensors required by PictureBank." />
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <ListBox x:Name="DownloadQueueListBox"
                             Grid.Row="4"
                             AutomationProperties.Name="Download queue"
                             ItemTemplate="{StaticResource DownloadQueueItemTemplate}"
                             Background="#0E141B"
                             BorderBrush="{StaticResource BrowserBorderBrush}"
                             Foreground="{StaticResource BrowserTextBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    <StackPanel Grid.Row="5" Margin="0,10,0,0">
                        <UniformGrid Columns="2">
                            <Button x:Name="PauseButton" Margin="0,0,6,6" Click="PauseButton_Click" Content="Pause" IsEnabled="False" AutomationProperties.Name="Pause download" />
                            <Button x:Name="ResumeButton" Margin="0,0,0,6" Click="ResumeButton_Click" Content="Resume" IsEnabled="False" AutomationProperties.Name="Resume download" />
                            <Button x:Name="RetryButton" Margin="0,0,6,6" Click="RetryButton_Click" Content="Retry" IsEnabled="False" AutomationProperties.Name="Retry download" />
                            <Button x:Name="CleanupButton" Margin="0,0,0,6" Click="CleanupButton_Click" Content="Cleanup" AutomationProperties.Name="Cleanup partial downloads" />
                        </UniformGrid>
                        <Button x:Name="CancelButton"
                                Click="CancelButton_Click"
                                Content="Cancel All"
                                IsEnabled="False"
                                AutomationProperties.Name="Cancel all downloads" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="8,6,8,8"
                Padding="10,0"
                Background="{StaticResource BrowserPanelAltBrush}"
                BorderBrush="{StaticResource BrowserBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Status"
                           DockPanel.Dock="Left"
                           Foreground="{StaticResource BrowserSubtleTextBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource BrowserTextBrush}"
                           Text="Ready"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="Download status" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
