<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="heirowLLM"
    Manufacturer="SocketJack"
    Version="$(var.ProductVersion)"
    UpgradeCode="{C77E28D2-7C1A-48F4-BE12-FB5D60A16B1C}"
    Scope="perMachine">

    <SummaryInformation Description="heirowLLM installer" Manufacturer="SocketJack" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of heirowLLM is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <Feature Id="MainFeature" Title="heirowLLM" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="ApplicationRegistry" />
      <ComponentRef Id="ApplicationStartMenuShortcut" />
      <ComponentRef Id="SecurityBrokerService" />
      <ComponentRef Id="SecurityEnrollmentMarker" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="heirowLLM" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="heirowLLM" />
    </StandardDirectory>

  </Package>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PayloadDir)\**\*.*">
        <Exclude Files="$(var.PayloadDir)\heirowLLM.SecurityBroker.exe" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="SecurityBrokerService" Guid="{7040DD97-E9A4-47DD-92C7-B97321A066F1}" Bitness="always64">
        <File Id="SecurityBrokerExecutable" Source="$(var.PayloadDir)\heirowLLM.SecurityBroker.exe" KeyPath="yes" />
        <ServiceInstall Id="SecurityBrokerInstaller"
                        Name="heirowLLMSecurityBroker"
                        DisplayName="heirowLLM Security Broker"
                        Description="Hardware-bound authentication broker for heirowLLM Workstation."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem">
          <util:PermissionEx User="Authenticated Users"
                             Domain="NT AUTHORITY"
                             ServiceStart="yes"
                             ServiceQueryStatus="yes"
                             ServiceInterrogate="yes" />
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              ResetPeriodInDays="1"
                              RestartServiceDelayInSeconds="1" />
        </ServiceInstall>
        <ServiceControl Id="SecurityBrokerControl" Name="heirowLLMSecurityBroker" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <RegistryValue Root="HKLM" Key="Software\SocketJack\heirowLLM\Security" Name="PublisherCertificateSha256" Type="string" Value="$(var.PublisherCertificateSha256)" />
        <RegistryValue Root="HKLM" Key="Software\SocketJack\heirowLLM\Security" Name="ManifestPublicKeyBase64" Type="string" Value="$(var.ManifestPublicKeyBase64)" />
      </Component>
      <Component Id="SecurityEnrollmentMarker" Guid="{1EE70EBB-9232-482F-883F-F003B10BD4B8}" Bitness="always64" NeverOverwrite="yes">
        <RegistryValue Root="HKLM" Key="Software\SocketJack\heirowLLM\Security" Name="EnrollmentState" Type="string" Value="Pending" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ApplicationRegistry" Guid="{208953B7-201D-4F4A-9947-5DF235EA8B3B}">
        <RegistryValue Root="HKLM" Key="Software\SocketJack\heirowLLM" Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationStartMenuShortcut" Guid="{618F1317-2A6B-47BF-A9C5-E356381EA834}">
        <Shortcut Id="heirowLLMStartMenuShortcut"
                  Name="heirowLLM"
                  Description="Launch heirowLLM"
                  Target="[INSTALLFOLDER]heirowLLM.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="heirowLLMUpdaterConsoleShortcut"
                  Name="heirowLLM Updater Console"
                  Description="Run a visible update check for heirowLLM"
                  Target="[SystemFolder]cmd.exe"
                  Arguments="/k &quot;&quot;[INSTALLFOLDER]heirowLLMUpdater.exe&quot; --check --target &quot;[INSTALLFOLDER]&quot; --manifest &quot;https://socketjack.com/update/meta&quot;&quot;"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\SocketJack\heirowLLM" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
